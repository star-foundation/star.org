# 本地运行所需的环境变量示例（复制为 .env 后按需填写，切勿提交真实密钥）
# 说明：Node 脚本直接读取进程环境变量，本地可用 `export $(grep -v '^#' .env | xargs)` 载入。

# —— 站点 ——
SITE_BASE_URL=https://star.org
REGISTRY_REPO_URL=https://github.com/your-org/star.org
LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx

# —— 登记幂等（同一笔订单重复触发不会分配第二颗星）——
STARORG_SLUG_SECRET=replace-with-a-long-random-string

# —— 邮件（不配置时邮件写入 outbox/ 目录，便于本地核对）——
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_TOKEN=
OPERATOR_EMAIL=you@example.com

# —— 对账（可选，用于发现"有支付无登记"的孤立订单）——
LEMON_SQUEEZY_API_KEY=

# —— 本地渲染（通常自动探测，无需设置）——
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
